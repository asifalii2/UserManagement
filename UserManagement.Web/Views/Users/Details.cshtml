
@model UserManagement.Web.Models.UserViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="card shadow-sm border-0 mx-auto" style="max-width: 650px;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h2 class="fw-bold mb-1">User Details</h2>
                <p class="text-muted mb-0">User ID: @Model.Id</p>
            </div>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>

        <dl class="row">
            <dt class="col-sm-4">First Name</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">Last Name</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Created At</dt>
            <dd class="col-sm-8">
                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
            </dd>
        </dl>

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary">Edit User</a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">Back to Users</a>
        </div>
    </div>
</div>
